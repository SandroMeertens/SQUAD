{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && $code.matches(/^[A-HJ-NP-Z2-9]{8}$/) && newData.child('ownerUid').val() === auth.uid && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 60000 && newData.child('createdAt').val() > now - 60000",
          ".validate": "newData.hasChildren(['ownerUid','createdAt'])",
          "ownerUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999"
          },
          "$other": {
            ".validate": false
          }
        },
        "seats": {
          ".read": "auth != null && root.child('rooms').child($code).child('info').exists()",
          "$slot": {
            ".write": "auth != null && root.child('rooms').child($code).child('info').exists() && ($slot.matches(/^[0-9]$/) || $slot.matches(/^1[0-9]$/) || $slot.matches(/^2[0-9]$/)) && !data.exists() && newData.val() === auth.uid && !root.child('rooms').child($code).child('members').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        },
        "members": {
          ".read": "auth != null && root.child('rooms').child($code).child('info').exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('seats').child(newData.child('seat').val() + '').val() === auth.uid",
            ".validate": "newData.hasChildren(['seat','team']) && ((newData.child('team').val() === 0 && newData.child('seat').val() >= 0 && newData.child('seat').val() < 5) || (newData.child('team').val() === 1 && newData.child('seat').val() >= 5 && newData.child('seat').val() < 10) || (newData.child('team').val() === 2 && newData.child('seat').val() >= 10 && newData.child('seat').val() < 15) || (newData.child('team').val() === 3 && newData.child('seat').val() >= 15 && newData.child('seat').val() < 20) || (newData.child('team').val() === 4 && newData.child('seat').val() >= 20 && newData.child('seat').val() < 25) || (newData.child('team').val() === 5 && newData.child('seat').val() >= 25 && newData.child('seat').val() < 30))",
            "seat": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 29"
            },
            "team": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "players": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child($uid).exists() && newData.exists()",
            ".validate": "newData.hasChildren(['team','round','x','z','grip','rescues','stumble','dir','lastMove']) && newData.child('team').val() === root.child('rooms').child($code).child('members').child($uid).child('team').val() && newData.child('round').val() === root.child('rooms').child($code).child('season').child('round').val()",
            "team": {
              ".validate": "newData.isNumber() && newData.val() === root.child('rooms').child($code).child('members').child(auth.uid).child('team').val()"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -8 && newData.val() <= 8"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 40"
            },
            "grip": {
              ".validate": "newData.isBoolean()"
            },
            "rescues": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
            },
            "stumble": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "dir": {
              "0": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              },
              "1": {
                ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
              },
              ".validate": "newData.hasChildren(['0','1'])",
              "$other": {
                ".validate": false
              }
            },
            "lastMove": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('members').child($uid).exists() && (newData.val() === true || !newData.exists())",
            ".validate": "newData.isBoolean()"
          }
        },
        "teams": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          "$team": {
            ".write": "auth != null && $team.matches(/^[0-5]$/) && root.child('rooms').child($code).child('members').child(auth.uid).child('team').val() + '' === $team && newData.exists()",
            ".validate": "newData.hasChildren(['id','round','cargo','couch','gate','fanOff','crashes','finished','stabilization','event','eventSeq'])",
            "id": {
              ".validate": "newData.isNumber() && (newData.val() + '') === $team"
            },
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200 && newData.val() === root.child('rooms').child($code).child('season').child('round').val()"
            },
            "cargo": {
              ".validate": "newData.isString() && newData.val().matches(/^(bank|pudding|wasmachine)$/)"
            },
            "couch": {
              ".validate": "newData.hasChildren(['x','z','wobble'])",
              "x": {
                ".validate": "newData.isNumber() && newData.val() >= -5 && newData.val() <= 5"
              },
              "z": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 35"
              },
              "wobble": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
              },
              "$other": {
                ".validate": false
              }
            },
            "gate": {
              ".validate": "newData.isBoolean()"
            },
            "fanOff": {
              ".validate": "newData.isBoolean()"
            },
            "crashes": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "finished": {
              ".validate": "newData.isBoolean()"
            },
            "stabilization": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
            },
            "event": {
              ".validate": "newData.isString() && newData.val().length <= 150"
            },
            "eventSeq": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "season": {
          ".read": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('members').child(auth.uid).exists() && newData.exists() && ((!data.exists() && newData.child('round').val() === 1) || (data.exists() && newData.child('round').val() === data.child('round').val() + 1 && data.child('round').val() < 200))",
          ".validate": "newData.hasChildren(['round','week','cityLevel','deliveries','crashes'])",
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 200"
          },
          "week": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40"
          },
          "cityLevel": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "deliveries": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "crashes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
